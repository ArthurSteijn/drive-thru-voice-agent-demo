# Azure VoiceLive API — Foundry Agent with Voice Live Settings
# Auth: DefaultAzureCredential (az login / Managed Identity) — no API key needed.
# The Agent handles all tool execution autonomously; no client-side function calling.
#
# RBAC roles required on the Foundry resource:
#   - Azure AI User          (agent SDK operations)
#   - Cognitive Services User (VoiceLive + model inference)
# See: platform/aif-resources/resource-setup.azcli

# ── Foundry Agent settings ──────────────────────────────────────────
PROJECT_ENDPOINT="https://aif-voiceliveapi-demo.services.ai.azure.com/api/projects/proj-voiceliveapi-demo"
AGENT_NAME="drivethru-ordering-agent"
VOICE_AGENT_NAME="drivethru-voice-agent"       # Native Voice Agent name (coexists side-by-side with main)
MODEL_DEPLOYMENT_NAME="gpt-5.4"
AGENT_VERSION=""                           # Optional: pin a specific version
CONVERSATION_ID=""                         # Optional: reconnect to existing conversation

# ── Voice Live settings ─────────────────────────────────────────────
# Used by: src/agents/voice_agent_validation.py (SDK client)
#          src/backend/relay.py              (WebSocket relay)
VOICELIVE_ENDPOINT="https://aif-voiceliveapi-demo.services.ai.azure.com/"
VOICELIVE_API_VERSION="2026-04-10"
VOICE_NAME="en-US-Ava:DragonHDLatestNeural"
PROJECT_NAME="proj-voiceliveapi-demo"
FOUNDRY_RESOURCE_OVERRIDE=""               # Optional: cross-resource agent hosting
AGENT_AUTHENTICATION_IDENTITY_CLIENT_ID="" # Optional: managed identity for cross-resource

# ── Azure environment ───────────────────────────────────────────────
AZURE_ENV_NAME="voice-lives-playground-3808"
AZURE_LOCATION="swedencentral"
AZURE_SUBSCRIPTION_ID="00000000-0000-0000-0000-000000000000"
AZURE_TENANT_ID="00000000-0000-0000-0000-000000000000"

# ── Microsoft Fabric Database ───────────────────────────────────────
FABRIC_CONNECTION_STRING="Driver={ODBC Driver 18 for SQL Server};Server=your-server.datawarehouse.fabric.microsoft.com;Database=DriveThru;Encrypt=yes;TrustServerCertificate=no;Authentication=ActiveDirectoryInteractive"
FABRIC_WORKSPACE_NAME="ws-drivethru-demo"    # Workspace display name (setup_fabric.py)
FABRIC_CAPACITY_ID=""                        # Leave empty to auto-detect trial capacity
FABRIC_DB_NAME="DriveThru"                    # SQL database display name
